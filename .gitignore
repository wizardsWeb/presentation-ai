# ============================================================================
# LARGE MODEL FILES - AI/ML Models
# ============================================================================
# Model files (can be very large - several GB)
*.gguf
*.ggml
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
*.h5
*.pb
*.onnx
*.tflite
*.pkl
*.pickle
*.joblib

# Model directories
/models/
/checkpoints/
/weights/
/pretrained/
/merged_fine_tuned_phi_model/

# ============================================================================
# LLAMA.CPP - Third-party dependency (exclude entire directory)
# ============================================================================
# llama.cpp is a large third-party repository - exclude it entirely
# Users should clone it separately: git clone https://github.com/ggerganov/llama.cpp.git backend/llama.cpp
# Or use it as a git submodule
backend/llama.cpp/

